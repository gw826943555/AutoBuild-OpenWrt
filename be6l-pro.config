# Tenda BE6L Pro (Airoha AN7563) 基础配置
# 目标平台：airoha / an7563，设备：tenda_be6l-pro
# 设备自带的 kmod-mt7992-23-firmware / kmod-phy-airoha-en8811h /
# airoha-en8811h-firmware 由 target 自动选中，无需在此重复声明。

# ---- 目标与设备 ----
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7563=y
CONFIG_TARGET_airoha_an7563_DEVICE_tenda_be6l-pro=y

# ---- LuCI 与语言 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-footstrap=y
# 英文为 LuCI 内置语言，无需单独配置
CONFIG_LUCI_LANG_zh_Hans=y

# ---- 常用 LuCI 应用（均来自默认 feeds）----
CONFIG_PACKAGE_luci-app-irqbalance=y
CONFIG_PACKAGE_luci-app-ttyd=y

# ---- 常用组件与工具 ----
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_tcpdump=y

# ---- 网络 / DNS ----
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-mbedtls=y
