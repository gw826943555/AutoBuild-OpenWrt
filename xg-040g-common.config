# 两个机型共用的软件包配置，修改此处即可同步到 md-ubi / mf-ubi
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_en=y
CONFIG_LUCI_LANG_zh_Hans=y

CONFIG_PACKAGE_luci-app-adblock=n
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-cpu-status-mini=n
CONFIG_PACKAGE_luci-app-crontab-wizard=n
CONFIG_PACKAGE_luci-app-disks-info=n
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-irqbalance=n
CONFIG_PACKAGE_luci-app-ksmbd=n
CONFIG_PACKAGE_luci-app-netbird=n
CONFIG_PACKAGE_luci-app-shadowsocks-rust=n
CONFIG_PACKAGE_luci-app-temp-status=n
CONFIG_PACKAGE_luci-app-transmission=n
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-usteer=n
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-vsftpd=n

CONFIG_PACKAGE_exfat-fsck=n
CONFIG_PACKAGE_exfat-mkfs=n
CONFIG_PACKAGE_adblock=n
CONFIG_PACKAGE_ariang=n
CONFIG_PACKAGE_bind-dig=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_blockd=n
CONFIG_PACKAGE_blkid=n
CONFIG_PACKAGE_conntrack=n
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb-storage-uas=n
CONFIG_PACKAGE_nano-full=n
CONFIG_PACKAGE_netbird=n
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_shadowsocks-rust-ssurl=n
CONFIG_PACKAGE_tcpdump=n
CONFIG_PACKAGE_aria2=n
CONFIG_ARIA2_NOXML=n
CONFIG_ARIA2_BITTORRENT=n
CONFIG_ARIA2_SFTP=n
CONFIG_ARIA2_ASYNC_DNS=n
CONFIG_ARIA2_COOKIE=n
CONFIG_ARIA2_WEBSOCKET=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-exfat=n
CONFIG_PACKAGE_kmod-mtd-rw=n
CONFIG_PACKAGE_kmod-wireguard=n

# devmem 直接读写寄存器支持
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
CONFIG_PACKAGE_devmem2=y

# 内核 /dev/mem 支持 (OpenWrt 用 KERNEL_ 前缀, 原生内核用 DEVMEM)
CONFIG_KERNEL_DEVMEM=y
# CONFIG_KERNEL_STRICT_DEVMEM is not set
# CONFIG_KERNEL_IO_STRICT_DEVMEM is not set

# PON Support
CONFIG_PACKAGE_kmod-airoha-i2c=y
CONFIG_PACKAGE_kmod-airoha-xpon-en757x=y
CONFIG_PACKAGE_kmod-airoha-pon-plugins=y
CONFIG_PACKAGE_kmod-airoha-pon-dataplane=y
CONFIG_PACKAGE_kmod-airoha-xpon-igmp=y
CONFIG_PACKAGE_kmod-airoha-gpon-igmp=y
CONFIG_PACKAGE_airoha-pon-manager=y
CONFIG_PACKAGE_airoha-pon-firmware=y
